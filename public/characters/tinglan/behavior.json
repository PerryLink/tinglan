  "rules": [
    {
      "on": "scene.enter",
      "to": "wake",
      "priority": 40
    },
    {
      "on": "wake",
      "to": "wake",
      "priority": 40,
      "voiceLineId": "greet_a"
    },
    {
      "on": "pat.head",
      "to": "pat",
      "priority": 50,
      "probability": 0.95,
      "voiceLineId": "pat_a"
    },
    {
      "on": "pat.body",
      "to": "pat",
      "priority": 50,
      "probability": 0.9
    },
    {
      "on": "pat.hand",
      "to": "pat_hand",
      "priority": 55,
      "probability": 0.95,
      "voiceLineId": "hand_a"
    },
    {
      "on": "pat.tablet",
      "to": "tablet_show",
      "priority": 55,
      "probability": 0.9,
      "voiceLineId": "tablet_a"
    },
    {
      "on": "pat.tail",
      "to": "pat_tail",
      "priority": 55,
      "probability": 0.95,
      "voiceLineId": "tail_a"
    },
    {
      "on": "pat.glasses",
      "to": "pat",
      "priority": 50,
      "probability": 0.75
    },
    {
      "on": "x-famling.pat.spam",
      "to": "refuse",
      "priority": 70,
      "probability": 1.0,
      "voiceLineId": "refuse_a"
    },
    {
      "on": "drag.fast",
      "to": "startle",
      "priority": 95,
      "probability": 0.9
    },
    {
      "on": "drag.start",
      "to": "drag",
      "priority": 100
    },
    {
      "on": "drag.end",
      "to": "land",
      "priority": 90
    },
    {
      "on": "land",
      "to": "land",
      "priority": 90,
      "probability": 0.92,
      "voiceLineId": "land_a"
    },
    {
      "on": "hover.dwell",
      "to": "look_out",
      "priority": 5
    },
    {
      "on": "brief.working",
      "to": "focus",
      "priority": 25
    },
    {
      "on": "brief.waiting",
      "to": "read",
      "priority": 15
    },
    {
      "on": "reminder.due",
      "to": "remind",
      "priority": 80,
      "requiresBrief": true,
      "voiceLineId": "remind_a"
    },
    {
      "on": "break.remind",
      "to": "stretch",
      "priority": 5,
      "voiceLineId": "break_a"
    },
    {
      "on": "talk",
      "to": "talk",
      "priority": 60
    },
    {
      "on": "sleep",
      "to": "sleep",
      "priority": 10
    },
    {
      "on": "wake.from_sleep",
      "to": "wake",
      "priority": 40,
      "probability": 0.8
    }
  ],
  "ambient": {
    "intervalMs": [
      45000,
      120000
    ],
    "choices": [
      {
        "state": "idle",
        "weight": 8
      },
      {
        "state": "read",
        "weight": 3
      },
      {
        "state": "look_out",
        "weight": 2
      },
      {
        "state": "stretch",
        "weight": 1
      }
    ]
  },
  "speech": {
    "lines": {
      "ack": "嗯。"
    }
  }
}
