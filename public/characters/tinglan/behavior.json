{
  "profile": "famling.behavior/0.1",
  "version": "0.1.0",
  "extends": "core:humanoid",
  "defaults": {
    "priority": 10,
    "interrupt": "at-end",
    "cooldownMs": 0
  },
  "abilities": {
    "speech": "text",
    "reminder": true,
    "needs": false,
    "death": false,
    "multiObject": true
  },
  "slots": {
    "idle": "idle",
    "pat": "pat",
    "talk": "talk",
    "remind": "remind",
    "sleep": "sleep"
  },
  "states": {
    "idle": {
      "tag": "idle",
      "loop": true,
      "priority": 0,
      "category": "idle"
    },
    "focus": {
      "tag": "focus",
      "loop": true,
      "priority": 25,
      "interrupt": "at-end",
      "after": "idle",
      "timeoutMs": 600000,
      "category": "expression"
    },
    "read": {
      "tag": "read",
      "loop": true,
      "priority": 15,
      "interrupt": "at-end",
      "after": "idle",
      "timeoutMs": 30000,
      "category": "micro-idle"
    },
    "talk": {
      "tag": "talk",
      "loop": true,
      "priority": 60,
      "interrupt": "at-end",
      "after": "idle",
      "category": "expression"
    },
    "remind": {
      "tag": "remind",
      "priority": 80,
      "interrupt": "immediate",
      "after": "idle",
      "cooldownMs": 60000,
      "category": "reaction"
    },
    "pat": {
      "tag": "pat",
      "priority": 50,
      "interrupt": "at-end",
      "after": "idle",
      "cooldownMs": 3000,
      "category": "reaction"
    },
    "pat_hand": {
      "tag": "pat_hand",
      "priority": 55,
      "interrupt": "at-end",
      "after": "idle",
      "cooldownMs": 6000,
      "category": "reaction"
    },
    "pat_tail": {
      "tag": "pat_tail",
      "priority": 55,
      "interrupt": "at-end",
      "after": "idle",
      "cooldownMs": 8000,
      "category": "reaction"
    },
    "drag": {
      "tag": "drag",
      "loop": true,
      "priority": 100,
      "interrupt": "immediate",
      "category": "interaction"
    },
    "land": {
      "tag": "land",
      "priority": 90,
      "interrupt": "immediate",
      "after": "idle",
      "cooldownMs": 1000,
      "category": "reaction"
    },
    "startle": {
      "tag": "startle",
      "priority": 95,
      "interrupt": "immediate",
      "after": "drag",
      "cooldownMs": 10000,
      "category": "reaction"
    },
    "sleep": {
      "tag": "sleep",
      "loop": true,
      "priority": 10,
      "interrupt": "never",
      "category": "sleep"
    },
    "wake": {
      "tag": "wake",
      "priority": 40,
      "interrupt": "immediate",
      "after": "idle",
      "cooldownMs": 5000,
      "category": "reaction"
