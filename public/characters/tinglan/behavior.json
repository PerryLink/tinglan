    "refuse": {
      "tag": "refuse",
      "priority": 70,
      "interrupt": "immediate",
      "after": "idle",
      "cooldownMs": 20000,
      "category": "reaction"
    },
    "look_out": {
      "tag": "look_out",
      "priority": 5,
      "interrupt": "at-end",
      "after": "idle",
      "cooldownMs": 15000,
      "category": "reaction"
