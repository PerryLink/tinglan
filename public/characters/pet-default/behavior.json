{
  "profile": "famling.behavior/0.1",
  "version": "0.1.0",
  "extends": "core:pet.cat",
  "defaults": {
    "priority": 10,
    "interrupt": "at-end",
    "cooldownMs": 0
  },
  "abilities": {
    "speech": "sfx",
    "reminder": true,
    "care": {
      "feed": true,
      "play": true,
      "sleep": true
    },
    "needs": true,
    "death": false,
    "multiObject": true
  },
  "slots": {
    "idle": "idle",
    "pat": "rub",
    "drag": "drag",
    "land": "land",
    "talk": "meow",
    "remind": "nudge",
    "sleep": "sleep",
    "feed": "play",
    "play": "play"
  },
  "states": {
    "idle": {
      "tag": "idle",
      "loop": true,
      "priority": 0
    },
    "rub": {
      "tag": "rub",
      "priority": 50,
      "after": "idle"
    },
    "drag": {
      "tag": "drag",
      "loop": true,
      "priority": 100
    },
    "land": {
      "tag": "land",
      "priority": 90,
      "after": "idle"
    },
    "meow": {
      "tag": "meow",
      "priority": 40,
      "after": "idle"
    },
    "nudge": {
      "tag": "nudge",
      "priority": 80,
      "after": "idle",
      "cooldownMs": 60000
    },
    "play": {
      "tag": "play",
      "priority": 55,
      "after": "idle"
    },
    "sleep": {
      "tag": "sleep",
      "loop": true,
      "priority": 10
    }
  },
  "rules": [
    {
      "on": "pat",
      "to": "rub",
      "priority": 50,
      "cooldownMs": 1500,
      "probability": 1.0
    },
    {
      "on": "feed",
      "to": "play",
      "priority": 55
    },
    {
      "on": "play",
      "to": "play",
      "priority": 55
    },
    {
      "on": "talk",
      "to": "meow",
      "priority": 40
    },
    {
      "on": "remind",
      "to": "nudge",
      "priority": 80,
      "requiresBrief": false
    },
    {
      "on": "drag.start",
      "to": "drag",
      "priority": 100
    },
    {
      "on": "land",
      "to": "land",
      "priority": 90
    },
    {
      "on": "sleep",
      "to": "sleep",
      "priority": 10
    }
  ],
  "ambient": {
    "intervalMs": [
      5000,
      12000
    ],
    "choices": [
      {
        "state": "idle",
        "weight": 5
      },
      {
        "state": "play",
        "weight": 1
      },
      {
        "state": "sleep",
        "weight": 2
      }
    ]
  },
  "needs": {
    "hunger": {
      "value": 50,
      "max": 100,
      "decayPerHour": 4,
      "criticalAt": 15
    },
    "energy": {
      "value": 60,
      "max": 100,
      "decayPerHour": 3,
      "criticalAt": 15
    },
    "fun": {
      "value": 50,
      "max": 100,
      "decayPerHour": 5,
      "criticalAt": 15
    }
  },
  "speech": {
    "lines": {
      "meow.1": "喵。",
      "nudge.1": "（蹭了蹭你）"
    }
  }
}
