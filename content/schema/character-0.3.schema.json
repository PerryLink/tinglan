      "propertyNames": {
        "not": {
          "pattern": "(clone|Clone|CLONE|impersonat|Impersonat|voiceSample|VoiceSample|referenceAudio|ReferenceAudio|referenceVoice|ReferenceVoice|speakerEmbedding|SpeakerEmbedding|voiceModel|VoiceModel)"
